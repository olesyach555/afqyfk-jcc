<Window x:Class="BakeryApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет хлебобулочной продукции" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: List of Products -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Продукция" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Button x:Name="btnAddProduct" Content="Добавить" Width="85" Margin="0,0,5,0" Click="btnAddProduct_Click"/>
                <Button x:Name="btnEditProduct" Content="Изменить" Width="85" Margin="0,0,5,0" Click="btnEditProduct_Click"/>
                <Button x:Name="btnDeleteProduct" Content="Удалить" Width="85" Click="btnDeleteProduct_Click"/>
            </StackPanel>
            <ListBox x:Name="productsListBox" SelectionChanged="productsListBox_SelectionChanged" DisplayMemberPath="Name"/>
        </DockPanel>

        <!-- Right Panel: Product Details -->
        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Padding="10">
            <Grid x:Name="detailsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Детали продукта" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Название:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Описание:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Цена (руб):" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:C2}}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Вес (гр):" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Weight, StringFormat={}{0:N2}}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Ингредиенты:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DataGrid ItemsSource="{Binding Ingredients}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Ingredient.Name}" Width="*"/>
                                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="Auto"/>
                                <DataGridTextColumn Header="Ед. изм." Binding="{Binding Ingredient.Unit}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
