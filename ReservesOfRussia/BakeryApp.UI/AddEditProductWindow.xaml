<Window x:Class="BakeryApp.UI.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Изменить продукт" MinWidth="450" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Название:" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtName" Text="{Binding Name}" Margin="0,0,0,5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Цена (руб):" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPrice" Text="{Binding Price}" Margin="0,0,0,5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Вес (гр):" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtWeight" Text="{Binding Weight}" Margin="0,0,0,5"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Описание:" VerticalAlignment="Top" Margin="0,5,10,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDescription" Text="{Binding Description}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" Margin="0,5,0,5"/>

        <!-- Ingredients Section -->
        <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Header="Ингредиенты" Margin="0,10,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <ComboBox x:Name="cmbIngredients" DisplayMemberPath="Name" Width="150" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtQuantity" Width="60" Margin="0,0,5,0"/>
                    <Button x:Name="btnAddIngredient" Content="Добавить" Click="btnAddIngredient_Click"/>
                    <Button x:Name="btnRemoveIngredient" Content="Удалить" Margin="5,0,0,0" Click="btnRemoveIngredient_Click"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="ingredientsGrid" ItemsSource="{Binding Ingredients}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="100" MaxHeight="200" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Ingredient.Name}" Width="*"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="Auto"/>
                        <DataGridTextColumn Header="Ед. изм." Binding="{Binding Ingredient.Unit}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>


        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="85" IsDefault="True" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="85" IsCancel="True" Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
