<Window x:Class="ReservesOfRussia.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reserves of Russia" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: List of Reserves -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Reserves" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Button x:Name="btnAddReserve" Content="Add" Width="75" Margin="0,0,5,0" Click="btnAddReserve_Click"/>
                <Button x:Name="btnEditReserve" Content="Edit" Width="75" Margin="0,0,5,0" Click="btnEditReserve_Click"/>
                <Button x:Name="btnDeleteReserve" Content="Delete" Width="75" Click="btnDeleteReserve_Click"/>
            </StackPanel>
            <ListBox x:Name="reservesListBox" SelectionChanged="reservesListBox_SelectionChanged" DisplayMemberPath="Name"/>
        </DockPanel>

        <!-- Right Panel: Reserve Details -->
        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Padding="10">
            <Grid x:Name="detailsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Reserve Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Name:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Region:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Region.Name}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Area (sq. km):" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Area, StringFormat={}{0:N2}}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Foundation Date:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding FoundationDate, StringFormat={}{0:dd MMMM yyyy}}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Description:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="2" x:Name="btnPrintInfo" Content="Print" Width="100" HorizontalAlignment="Right" Margin="0,10,0,0" Click="btnPrintInfo_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
